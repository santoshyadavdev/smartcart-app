{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartcart-app",
  "main": "dist/smartcartapp/server/server.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/smartcartapp/browser",
    "binding": "ASSETS",
  }
}
